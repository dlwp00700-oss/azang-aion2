{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aion2.plaync.com/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/simulator.html",
      "destination": "/simulator",
      "permanent": true
    },
    {
      "source": "/auto.html",
      "destination": "/auto",
      "permanent": true
    },
    {
      "source": "/pet.html",
      "destination": "/pet",
      "permanent": true
    },
    {
      "source": "/abyss.html",
      "destination": "/abyss",
      "permanent": true
    },
    {
      "source": "/deva.html",
      "destination": "/deva",
      "permanent": true
    },
    {
      "source": "/stigma.html",
      "destination": "/stigma",
      "permanent": true
    },
    {
      "source": "/ranking.html",
      "destination": "/ranking",
      "permanent": true
    }
  ]
}
