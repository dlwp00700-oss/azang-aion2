{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/user/:server/:name",
      "destination": "/api/userPage"
    },
    {
      "source": "/api/cronStats",
      "destination": "/api/cronStats.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cronStats",
      "schedule": "0 0 * * *"
    }
  ]
}
